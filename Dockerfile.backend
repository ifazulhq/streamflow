FROM node:20-alpine

# Install FFmpeg, OpenSSL, bash, and build tools
RUN apk add --no-cache ffmpeg openssl bash python3 make g++

WORKDIR /app

# Copy package descriptors for caching layers
COPY api-server/package*.json ./api-server/
COPY transcoding-worker/package*.json ./transcoding-worker/

# Install dependencies for both services
RUN cd /app/api-server && npm install
RUN cd /app/transcoding-worker && npm install

# Copy application source code
COPY api-server ./api-server
COPY transcoding-worker ./transcoding-worker
COPY start-backend.sh ./start-backend.sh

# Generate/emit Prisma database contract
RUN cd /app/api-server && npm run contract:emit || true

# Prepare scratch and upload directories and permissions
RUN chmod +x ./start-backend.sh && \
    mkdir -p /app/transcoding-worker/temp && \
    mkdir -p /app/api-server/uploads

EXPOSE 4000

ENV PORT=4000
ENV NODE_ENV=production

CMD ["./start-backend.sh"]
